# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated code (regenerate with `flutter pub get` / `dart run build_runner build`).
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
lib/core/localization/generated/

# Downloaded drift web assets are vendored deliberately (offline-first PWA),
# so they are intentionally NOT ignored here.

# Re-fetchable raw upstream sources for the production Quran dataset
# (tool/quran_data/fetch_sources.dart repopulates this). The vendored QUL
# layout/word-by-word zips under tool/quran_data/sources/ are NOT ignored —
# they cannot be re-fetched automatically (see docs/QURAN_DATA_PROVENANCE.md)
# and are committed deliberately, small enough to be reasonable in git.
tool/quran_data/.cache/

# The QPC V2 per-page font package (~136MB, 604 individual TTFs) is
# deliberately NOT committed yet — its packaging strategy (which formats,
# whether all 604 pages ship in every build, compression) is an explicit
# pending decision, not something to bloat repo history with by accident.
tool/quran_data/sources/*.bz2
tool/quran_data/sources/*Font*
