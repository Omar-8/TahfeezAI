# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated code (regenerate with `flutter pub get` / `dart run build_runner build`).
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
lib/core/localization/generated/

# Downloaded drift web assets are vendored deliberately (offline-first PWA),
# so they are intentionally NOT ignored here.

# Re-fetchable raw upstream sources for the production Quran dataset
# (tool/quran_data/fetch_sources.dart repopulates this). The vendored QUL
# layout/word-by-word zips under tool/quran_data/sources/ are NOT ignored —
# they cannot be re-fetched automatically (see docs/QURAN_DATA_PROVENANCE.md)
# and are committed deliberately, small enough to be reasonable in git.
tool/quran_data/.cache/

# The QPC V2 per-page font package (~136MB, 604 individual TTFs) is
# deliberately NOT committed yet — its packaging strategy (which formats,
# whether all 604 pages ship in every build, compression) is an explicit
# pending decision, not something to bloat repo history with by accident.
tool/quran_data/sources/*.bz2
tool/quran_data/sources/*Font*

# The QCF2BSML (Bismillah) and QUL Surah Header fonts, plus their ligature
# mapping, are the same category as the block above: real, copyrighted font
# files whose redistribution terms are unverified (SHIP_BLOCKED_LICENSE, see
# docs/QURAN_DATA_PROVENANCE.md) — not committed, unlike the small QUL
# layout/word-by-word database zips above. `*Font*` above doesn't happen to
# match these filenames, so they need their own patterns.
tool/quran_data/sources/QCF2BSML.ttf
tool/quran_data/sources/QCF_SurahHeader*
tool/quran_data/sources/ligatures.json*

# quran_common.ttf/suracon.ttf (QuranApp's own special-line fonts, vendored
# from a local AlfaazPlus/QuranApp checkout) are the same category: real,
# copyrighted font files whose redistribution terms are unverified
# (SHIP_BLOCKED_LICENSE — QuranApp's repo-level GPLv3 does not necessarily
# extend to these specific font resources, see
# docs/QURAN_DATA_PROVENANCE.md §12/§13) — not committed.
tool/quran_data/sources/quran_common.ttf
tool/quran_data/sources/suracon.ttf
tool/quran_data/sources/uthmanic_hafs.ttf
# QUL's own official QPC Hafs font package — confirmed byte-identical to
# uthmanic_hafs.ttf above, same SHIP_BLOCKED_LICENSE status.
tool/quran_data/sources/UthmanicHafs_V22.ttf.zip

# The generated QPC Hafs display-word manifest (assets/quran/quran_display/)
# is real, fully validated Quran text (docs/QURAN_DATA_PROVENANCE.md §17)
# but is deliberately NOT committed while QUL's redistribution terms for
# the QPC Hafs word-by-word script remain unverified (SHIP_BLOCKED_LICENSE)
# — same treatment, and same reasoning, as assets/quran/mushaf/ above.
# Regenerate locally with
# `dart run tool/quran_data/build_qpc_hafs_display.dart` (the vendored
# source zip it needs, tool/quran_data/sources/qpc-hafs-word-by-word.db.zip,
# is committed).
assets/quran/quran_display/

# The generated production Mushaf dataset (assets/quran/mushaf/) is real,
# fully validated data (see docs/QURAN_DATA_PROVENANCE.md §7c) but is
# deliberately NOT committed while QUL's redistribution terms for the
# layout/word-by-word resources remain unverified (SHIP_BLOCKED_LICENSE) —
# committing it to the shared repository would distribute that content
# before the release gate clears. Regenerate locally with
# `dart run tool/quran_data/build_production_data.dart` (the vendored source
# zips it needs are committed); test/quran_data/mushaf_*_test.dart require
# this file to exist and are skipped-by-failure otherwise, the same
# prerequisite the other qul_*_test.dart real-data tests already have.
assets/quran/mushaf/

# The generated, copied QPC V2 page fonts (604 real TTFs, ~200MB) — same
# unresolved redistribution status as the raw vendored package
# (tool/quran_data/sources/*Font*, also gitignored) and the Mushaf dataset
# above. Regenerate locally with `dart run tool/quran_data/build_qpc_fonts.dart`
# (requires the vendored font package to exist first — see
# docs/QURAN_DATA_PROVENANCE.md §8). test/quran_data/qpc_font_manifest_test.dart
# and test/features/mushaf/data/font_loader_qpc_page_font_manager_test.dart
# require these files and skip/fail gracefully otherwise.
assets/quran/fonts/

# The generated font manifest (assets/quran/manifests/qpc_v2_fonts.json) is
# NOT gitignored — unlike the font files themselves, it contains no
# copyrighted content (only page numbers, filenames, font family names, and
# hashes), the same reasoning that already keeps resource_manifest.json
# committed despite recording hashes of other gated resources.
!assets/quran/manifests/
