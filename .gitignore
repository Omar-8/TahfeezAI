# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated code (regenerate with `flutter pub get` / `dart run build_runner build`).
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
lib/core/localization/generated/

# Downloaded drift web assets are vendored deliberately (offline-first PWA),
# so they are intentionally NOT ignored here.

# Re-fetchable raw upstream sources for the production Quran dataset
# (tool/quran_data/fetch_sources.dart repopulates this). The vendored QUL
# layout zip under tool/quran_data/sources/ is NOT ignored — it cannot be
# re-fetched automatically (see docs/QURAN_DATA_PROVENANCE.md) and is
# committed deliberately.
tool/quran_data/.cache/
