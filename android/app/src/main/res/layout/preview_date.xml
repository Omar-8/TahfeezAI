<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (sample content; the app's look). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_glass_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="60dp" android:layout_height="56dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/widget_small_glass_light">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="19sp" android:textStyle="bold" android:textColor="#176B5B" />
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="a" android:format24Hour="" android:textSize="11sp" android:textStyle="bold" android:textColor="#176B5B" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEEE, MMMM d" android:format24Hour="EEEE, MMMM d" android:textSize="15sp" android:textStyle="bold" android:textColor="#18201D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/widget_date" android:textSize="13sp" android:textColor="#58635E" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_preview_icon_sun" />
    </LinearLayout>
</LinearLayout>
