<?xml version="1.0" encoding="utf-8"?>
<!-- Tahfeez's duas widget (owner, 2026-11-22): resizable, sized as on Home
     by default (TahfeezWidgets.kt); its picker preview: preview_duas. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="57dp"
    android:minHeight="57dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_tile"
    android:previewLayout="@layout/preview_duas"
    android:previewImage="@drawable/widget_preview_duas"
    android:description="@string/widget_duas"
    android:updatePeriodMillis="1800000" />
