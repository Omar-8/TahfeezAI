<?xml version="1.0" encoding="utf-8"?>
<!-- Tahfeez's home widget (owner, 2026-11-22): resizable, sized as on Home
     by default (TahfeezWidgets.kt); its picker preview: preview_home. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="220dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="5"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_home"
    android:previewLayout="@layout/preview_home"
    android:previewImage="@drawable/widget_preview_home"
    android:description="@string/widget_home"
    android:updatePeriodMillis="1800000" />
