<?xml version="1.0" encoding="utf-8"?>
<!-- The khatmah's progress bar (light): a pale track, the app's green. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp" /><solid android:color="#E4E8E5" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="4dp" /><solid android:color="#176B5B" /></shape></clip>
    </item>
</layer-list>
