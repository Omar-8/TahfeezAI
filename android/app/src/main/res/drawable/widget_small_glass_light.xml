<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen widget's frosted glass (light), as the app's raised glass
     cards (TahfeezGlassSurface raised): paper fading across, a faint green
     edge. A widget can't blur the wallpaper; the rest is the same. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="#DBFFFFFF" android:endColor="#B3F7F8F4" />
    <stroke android:width="1dp" android:color="#29176B5B" />
    <corners android:radius="16dp" />
</shape>
